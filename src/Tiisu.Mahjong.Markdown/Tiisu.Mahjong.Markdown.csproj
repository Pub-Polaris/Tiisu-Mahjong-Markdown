<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Tiisu.Mahjong.Markdown</PackageId>
    <Version>1.0.3</Version>
    <Authors>公民北极星_Official</Authors>
    <Description>Portable Markdown + mahjong tile notation renderer for Unity, Godot and other C# hosts.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Pub-Polaris/Tiisu-Mahjong-Markdown</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Compile Include="..\..\IsExternalInit.cs" Link="IsExternalInit.cs" />
  </ItemGroup>
</Project>
